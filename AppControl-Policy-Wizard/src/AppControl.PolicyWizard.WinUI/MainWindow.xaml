<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AppControl.PolicyWizard.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="App Control Policy Wizard"
            Subtitle="Policy workflow">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            CompactModeThresholdWidth="800"
            CompactPaneLength="48"
            ExpandedModeThresholdWidth="1050"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            IsPaneToggleButtonVisible="True"
            OpenPaneLength="216"
            PaneDisplayMode="Auto"
            SelectionFollowsFocus="Disabled">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Icon="Home" Tag="home" />
                <NavigationViewItem
                    x:Name="CreatePolicyNavigationItem"
                    Content="Create or edit policy"
                    Icon="Edit"
                    IsSelected="True"
                    Tag="policy" />
                <NavigationViewItem Content="Merge policies" Icon="Copy" IsEnabled="False" Tag="merge" />

                <NavigationViewItemSeparator />

                <NavigationViewItemHeader Content="Policy workflow" />
                <NavigationViewItem
                    x:Name="TemplateStepNavigationItem"
                    Content="1  Choose source"
                    SelectsOnInvoked="False" />
                <NavigationViewItem
                    x:Name="BehaviorStepNavigationItem"
                    Content="2  Policy behavior"
                    IsEnabled="False"
                    SelectsOnInvoked="False" />
                <NavigationViewItem
                    x:Name="RulesStepNavigationItem"
                    Content="3  Application rules"
                    IsEnabled="False"
                    SelectsOnInvoked="False" />
                <NavigationViewItem
                    x:Name="SettingsStepNavigationItem"
                    Content="4  Choose output"
                    IsEnabled="False"
                    SelectsOnInvoked="False" />
                <NavigationViewItem
                    x:Name="ReviewStepNavigationItem"
                    Content="5  Review"
                    IsEnabled="False"
                    SelectsOnInvoked="False" />
            </NavigationView.MenuItems>

            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <InfoBar
                    x:Name="ValidationInfoBar"
                    Margin="32,16,32,0"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Warning"
                    Title="Check the policy settings" />

                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <Grid
                        MaxWidth="980"
                        Padding="32,24,32,36"
                        HorizontalAlignment="Stretch">

                        <Grid x:Name="TemplatePage">
                            <StackPanel Spacing="20">
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Choose a policy source" />
                                    <TextBlock
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="Start from a recommended Microsoft template or continue from an existing App Control policy." />
                                </StackPanel>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        x:Name="SignedReputableButton"
                                        Grid.Column="0"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        AutomationProperties.Name="Select Signed and reputable template"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Tag="Signed and Reputable"
                                        Click="PolicySourceCard_Click">
                                        <Border
                                            x:Name="SignedReputableCard"
                                            Style="{StaticResource CardStyle}">
                                            <StackPanel Spacing="12">
                                                <Grid>
                                                    <Border
                                                        Width="44"
                                                        Height="44"
                                                        HorizontalAlignment="Left"
                                                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                        CornerRadius="8">
                                                        <FontIcon
                                                            FontFamily="Segoe Fluent Icons"
                                                            FontSize="22"
                                                            Glyph="&#xEA18;" />
                                                    </Border>
                                                    <Border
                                                        Padding="8,3"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                                        CornerRadius="10">
                                                        <TextBlock
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Text="RECOMMENDED" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock
                                                    Style="{StaticResource SectionTitleStyle}"
                                                    Text="Signed and reputable" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="Extends the Windows baseline with Smart App Control reputation for broader application compatibility." />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon
                                                        x:Name="SignedReputableSelectedIcon"
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="14"
                                                        Glyph="&#xE73E;" />
                                                    <TextBlock
                                                        x:Name="SignedReputableSelectionText"
                                                        VerticalAlignment="Center"
                                                        FontWeight="SemiBold"
                                                        Text="Selected" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Button>

                                    <Button
                                        x:Name="WindowsOnlyButton"
                                        Grid.Column="1"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        AutomationProperties.Name="Select Windows only template"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Tag="Windows Only"
                                        Click="PolicySourceCard_Click">
                                        <Border
                                            x:Name="WindowsOnlyCard"
                                            Style="{StaticResource CardStyle}">
                                            <StackPanel Spacing="12">
                                                <Border
                                                    Width="44"
                                                    Height="44"
                                                    HorizontalAlignment="Left"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                    CornerRadius="8">
                                                    <FontIcon
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="22"
                                                        Glyph="&#xE7F8;" />
                                                </Border>
                                                <TextBlock
                                                    Style="{StaticResource SectionTitleStyle}"
                                                    Text="Windows only" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="Uses the Windows-only baseline for tightly managed devices with the narrowest application compatibility." />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon
                                                        x:Name="WindowsOnlySelectedIcon"
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="14"
                                                        Glyph="&#xE73E;"
                                                        Visibility="Collapsed" />
                                                    <TextBlock
                                                        x:Name="WindowsOnlySelectionText"
                                                        VerticalAlignment="Center"
                                                        FontWeight="SemiBold"
                                                        Text="Selected"
                                                        Visibility="Collapsed" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Button>

                                    <Button
                                        x:Name="ExistingPolicyButton"
                                        Grid.Column="2"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        AutomationProperties.Name="Open an existing App Control policy"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Tag="Existing Policy"
                                        Click="PolicySourceCard_Click">
                                        <Border
                                            x:Name="ExistingPolicyCard"
                                            Style="{StaticResource CardStyle}">
                                            <StackPanel Spacing="12">
                                                <Border
                                                    Width="44"
                                                    Height="44"
                                                    HorizontalAlignment="Left"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                    CornerRadius="8">
                                                    <FontIcon
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="22"
                                                        Glyph="&#xE8E5;" />
                                                </Border>
                                                <TextBlock
                                                    Style="{StaticResource SectionTitleStyle}"
                                                    Text="Open existing policy" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="Continue from an App Control XML policy saved elsewhere on this device." />
                                                <TextBlock
                                                    x:Name="ExistingPolicyFileName"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    TextTrimming="CharacterEllipsis"
                                                    Visibility="Collapsed" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon
                                                        x:Name="ExistingPolicySelectedIcon"
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="14"
                                                        Glyph="&#xE73E;"
                                                        Visibility="Collapsed" />
                                                    <TextBlock
                                                        x:Name="ExistingPolicySelectionText"
                                                        VerticalAlignment="Center"
                                                        FontWeight="SemiBold"
                                                        Text="Selected"
                                                        Visibility="Collapsed" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </Grid>

                                <InfoBar
                                    IsOpen="True"
                                    IsClosable="False"
                                    Severity="Informational"
                                    Title="One policy workflow"
                                    Message="Templates create a new policy identity. Existing policies preserve their identity. Application rules are reviewed in the same workflow." />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="BehaviorPage" Visibility="Collapsed">
                            <StackPanel Spacing="20">
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Choose policy behavior" />
                                    <TextBlock
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="Settings are grouped by their effective runtime scope. Unrecognized policy content is preserved unless you explicitly change it." />
                                </StackPanel>

                                <InfoBar
                                    x:Name="PolicyTypeInfoBar"
                                    IsOpen="True"
                                    IsClosable="False"
                                    Severity="Informational"
                                    Title="Base policy"
                                    Message="This policy can define application, driver, trust, and supplemental-policy behavior." />

                                <Border Style="{StaticResource CardStyle}">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="10">
                                            <StackPanel Spacing="3">
                                                <TextBlock
                                                    x:Name="BehaviorSourceTitle"
                                                    FontWeight="SemiBold"
                                                    Text="Loaded from Signed and reputable template" />
                                                <TextBlock
                                                    x:Name="BehaviorSourceMessage"
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="The controls below reflect the normalized template defaults." />
                                            </StackPanel>
                                            <StackPanel Spacing="3">
                                                <TextBlock
                                                    x:Name="BehaviorChangeTitle"
                                                    FontWeight="SemiBold"
                                                    Text="No changes from source" />
                                                <TextBlock
                                                    x:Name="BehaviorChangeDetails"
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="All exposed settings still match the selected policy source." />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button
                                            x:Name="ResetBehaviorButton"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Reset policy behavior to source defaults"
                                            Content="Reset to source defaults"
                                            IsEnabled="False"
                                            Click="ResetBehaviorButton_Click" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="18">
                                        <StackPanel Spacing="4">
                                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Policy-scoped behavior" />
                                            <TextBlock
                                                Style="{StaticResource SecondaryTextStyle}"
                                                Text="These choices primarily control what this policy evaluates and trusts." />
                                        </StackPanel>

                                        <StackPanel Spacing="8">
                                            <TextBlock FontWeight="SemiBold" Text="Deployment mode" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ToggleButton
                                                    x:Name="AuditModeButton"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    AutomationProperties.Name="Use audit mode"
                                                    Content="Audit"
                                                    IsChecked="True"
                                                    Tag="Audit"
                                                    Click="DeploymentModeButton_Click" />
                                                <ToggleButton
                                                    x:Name="EnforcedModeButton"
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    AutomationProperties.Name="Use enforced mode"
                                                    Content="Enforced"
                                                    Tag="Enforced"
                                                    Click="DeploymentModeButton_Click" />
                                            </Grid>
                                            <TextBlock
                                                Style="{StaticResource SecondaryTextStyle}"
                                                Text="Audit records policy decisions without enforcing ordinary allow rules. Device-wide and special settings may still alter runtime behavior." />
                                        </StackPanel>

                                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                        <StackPanel Spacing="8">
                                            <TextBlock FontWeight="SemiBold" Text="Policy scope" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ToggleButton
                                                    x:Name="ApplicationsAndDriversButton"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    AutomationProperties.Name="Control applications and drivers"
                                                    Content="Applications and drivers"
                                                    IsChecked="True"
                                                    Tag="Applications"
                                                    Click="PolicyScopeButton_Click" />
                                                <ToggleButton
                                                    x:Name="DriversOnlyButton"
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    AutomationProperties.Name="Control drivers only"
                                                    Content="Drivers only"
                                                    Tag="Drivers"
                                                    Click="PolicyScopeButton_Click" />
                                            </Grid>
                                            <TextBlock
                                                Style="{StaticResource SecondaryTextStyle}"
                                                Text="Applications and drivers enables user-mode code integrity. Driver-only policies don't expose user-mode trust or script controls." />
                                        </StackPanel>

                                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                        <ToggleSwitch
                                            x:Name="AllowSupplementalToggle"
                                            Header="Allow supplemental policies to extend this base"
                                            OffContent="Not extensible"
                                            OnContent="Extensible" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="16">
                                        <StackPanel Spacing="4">
                                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Trust sources" />
                                            <TextBlock
                                                Style="{StaticResource SecondaryTextStyle}"
                                                Text="Each policy independently chooses whether to trust these sources. Managed Installer environment configuration remains separate." />
                                        </StackPanel>
                                        <ToggleSwitch
                                            x:Name="CloudReputationToggle"
                                            Header="Allow code predicted safe by Smart App Control"
                                            OffContent="Intelligent Security Graph disabled"
                                            OnContent="Intelligent Security Graph enabled"
                                            Toggled="CloudReputationToggle_Toggled" />
                                        <StackPanel Margin="24,0,0,0" Spacing="4">
                                            <ToggleSwitch
                                                x:Name="InvalidateEasToggle"
                                                Header="Revalidate Smart App Control reputation after restart"
                                                OffContent="Cached reputation retained"
                                                OnContent="Revalidate after restart" />
                                            <TextBlock
                                                Style="{StaticResource SecondaryTextStyle}"
                                                Text="Device-wide effect. Available only for application-and-driver policies that enable Intelligent Security Graph authorization." />
                                        </StackPanel>
                                        <ToggleSwitch
                                            x:Name="ManagedInstallerToggle"
                                            Header="Managed Installer"
                                            OffContent="Not trusted"
                                            OnContent="Trusted" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="16">
                                        <StackPanel Spacing="4">
                                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Special enforcement behavior" />
                                            <TextBlock
                                                Style="{StaticResource SecondaryTextStyle}"
                                                Text="These settings are authored by this policy but don't follow Audit versus Enforced in all circumstances." />
                                        </StackPanel>
                                        <ToggleSwitch
                                            x:Name="ScriptEnforcementToggle"
                                            Header="Enforce supported scripts"
                                            OffContent="Script enforcement disabled"
                                            OnContent="Script enforcement enabled" />
                                        <ToggleSwitch
                                            x:Name="DynamicCodeSecurityToggle"
                                            Header="Activate additional .NET dynamic code security mitigations"
                                            OffContent="Disabled"
                                            OnContent="Additional mitigations active"
                                            Toggled="DynamicCodeSecurityToggle_Toggled" />
                                        <InfoBar
                                            x:Name="DynamicCodeWarning"
                                            IsOpen="False"
                                            IsClosable="False"
                                            Severity="Warning"
                                            Title="Use Dynamic Code Security with caution"
                                            Message="Dynamic Code Security turns on multiple security-hardening features in .NET and may cause unexpected behavior for some apps. This can occur even when the policy is set to audit mode. Some apps may encounter failures without any corresponding events logged. Use with caution." />
                                    </StackPanel>
                                </Border>

                                <Expander Header="Device-wide runtime controls" IsExpanded="False">
                                    <Border Margin="0,8,0,0" Style="{StaticResource CardStyle}">
                                        <StackPanel Spacing="16">
                                            <TextBlock
                                                Style="{StaticResource SecondaryTextStyle}"
                                                Text="These settings can change boot, driver, or reputation behavior for the device and aren't controlled solely by this policy's deployment mode." />
                                            <ToggleSwitch
                                                x:Name="HvciToggle"
                                                Header="Hypervisor-protected Code Integrity"
                                                OffContent="Disabled"
                                                OnContent="Enabled" />
                                            <TextBlock
                                                x:Name="HvciSummaryText"
                                                Style="{StaticResource SecondaryTextStyle}"
                                                Text="Changes the device runtime environment and isn't governed by Audit mode." />
                                            <ToggleSwitch
                                                x:Name="WhqlOnlyToggle"
                                                Header="Require WHQL drivers"
                                                OffContent="Standard driver trust"
                                                OnContent="WHQL required" />
                                            <ToggleSwitch
                                                x:Name="FlightSigningToggle"
                                                Header="Allow flight-signed code"
                                                OffContent="Flight signing disabled"
                                                OnContent="Flight signing allowed" />
                                            <ToggleSwitch
                                                x:Name="AdvancedBootToggle"
                                                Header="Enable advanced boot options menu"
                                                OffContent="Disabled"
                                                OnContent="Enabled" />
                                            <ToggleSwitch
                                                x:Name="BootAuditToggle"
                                                Header="Fall back to boot audit on failure"
                                                OffContent="Disabled"
                                                OnContent="Enabled" />
                                        </StackPanel>
                                    </Border>
                                </Expander>

                                <Expander Header="Advanced policy-scoped controls" IsExpanded="False">
                                    <Border Margin="0,8,0,0" Style="{StaticResource CardStyle}">
                                        <StackPanel Spacing="16">
                                            <ToggleSwitch
                                                x:Name="UpdateNoRebootToggle"
                                                Header="Apply policy updates without reboot"
                                                OffContent="Reboot may be required"
                                                OnContent="No reboot update" />
                                            <ToggleSwitch
                                                x:Name="StoreAppsToggle"
                                                Header="Enforce Store applications"
                                                OffContent="Not required"
                                                OnContent="Required" />
                                            <ToggleSwitch
                                                x:Name="FilePathProtectionToggle"
                                                Header="Protect FilePath rules at runtime"
                                                OffContent="Runtime protection disabled"
                                                OnContent="Runtime protection enabled" />
                                            <ToggleSwitch
                                                x:Name="RevokedAsUnsignedToggle"
                                                Header="Treat revoked or expired signatures as unsigned"
                                                OffContent="Preserve signature classification"
                                                OnContent="Evaluate as unsigned" />
                                        </StackPanel>
                                    </Border>
                                </Expander>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="12">
                                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Platform and compatibility" />
                                        <StackPanel Spacing="3">
                                            <TextBlock FontWeight="SemiBold" Text="Deployment protection" />
                                            <TextBlock
                                                x:Name="SigningStatusText"
                                                Style="{StaticResource SecondaryTextStyle}"
                                                Text="Unsigned policy output is allowed." />
                                        </StackPanel>
                                        <StackPanel Spacing="3">
                                            <TextBlock FontWeight="SemiBold" Text="Secure and app settings" />
                                            <TextBlock
                                                x:Name="PlatformSettingsSummary"
                                                Style="{StaticResource SecondaryTextStyle}"
                                                Text="No configurable platform behaviors were detected." />
                                        </StackPanel>
                                        <StackPanel Spacing="3">
                                            <TextBlock FontWeight="SemiBold" Text="Compatibility findings" />
                                            <TextBlock
                                                x:Name="CompatibilitySummary"
                                                Style="{StaticResource SecondaryTextStyle}"
                                                Text="No unsupported or unknown policy options were detected." />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="RulesPage" Visibility="Collapsed">
                            <StackPanel Spacing="20">
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Choose application rules" />
                                    <TextBlock
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="Add evidence, review ranked identities, and stage only the rules you intend to add. Existing policy content remains preserved." />
                                </StackPanel>

                                <InfoBar
                                    x:Name="RuleIntentInfoBar"
                                    IsOpen="True"
                                    IsClosable="False"
                                    Severity="Informational"
                                    Title="Allow applications"
                                    Message="This policy workflow adds allow rules. Deny authoring will use a separate policy workflow." />

                                <StackPanel Spacing="12">
                                    <Border Style="{StaticResource CardStyle}">
                                        <Grid ColumnSpacing="20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="10">
                                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Evidence sources" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button
                                                        Content="Add a file"
                                                        Click="AddRuleFileButton_Click" />
                                                    <Button
                                                        Content="Advanced manual entry"
                                                        Click="ManualRuleButton_Click" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock FontWeight="SemiBold" Text="Workspace summary" />
                                                <TextBlock
                                                    x:Name="ExistingRulesSummary"
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="No existing logical rules detected." />
                                                <TextBlock
                                                    x:Name="EvidenceSummary"
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="No evidence added." />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource SecondaryTextStyle}"
                                                Text="Folders, events, installed packages, and COM authorization follow in later slices."
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Rule candidates" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="Recommendations are ordered from update-friendly identities to exact-file fallbacks." />
                                            </StackPanel>
                                            <ListView
                                                x:Name="RuleCandidateList"
                                                Grid.Row="1"
                                                Margin="0,12,0,12"
                                                Height="120"
                                                SelectionChanged="RuleCandidateList_SelectionChanged" />
                                            <InfoBar
                                                x:Name="RuleWorkspaceInfoBar"
                                                Grid.Row="2"
                                                IsOpen="False"
                                                IsClosable="True"
                                                Severity="Informational" />
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}">
                                        <Grid ColumnSpacing="20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.35*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="1.15*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="10">
                                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Candidate details" />
                                                <TextBlock
                                                    x:Name="RuleCandidateTitle"
                                                    FontWeight="SemiBold"
                                                    Text="Select a candidate" />
                                                <TextBlock
                                                    x:Name="RuleCandidateEffect"
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="Add a file or create a manual candidate to inspect its effect."
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="10">
                                                <StackPanel Spacing="3">
                                                    <TextBlock FontWeight="SemiBold" Text="Trust breadth" />
                                                    <TextBlock x:Name="RuleTrustBreadthText" Style="{StaticResource SecondaryTextStyle}" Text="Not evaluated" />
                                                </StackPanel>
                                                <StackPanel Spacing="3">
                                                    <TextBlock FontWeight="SemiBold" Text="Update resilience" />
                                                    <TextBlock x:Name="RuleUpdateResilienceText" Style="{StaticResource SecondaryTextStyle}" Text="Not evaluated" />
                                                </StackPanel>
                                                <StackPanel Spacing="3">
                                                    <TextBlock FontWeight="SemiBold" Text="Evidence quality" />
                                                    <TextBlock x:Name="RuleEvidenceQualityText" Style="{StaticResource SecondaryTextStyle}" Text="Not evaluated" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="10">
                                                <StackPanel Spacing="3">
                                                    <TextBlock FontWeight="SemiBold" Text="Concerns" />
                                                    <TextBlock
                                                        x:Name="RuleConcernsText"
                                                        Style="{StaticResource SecondaryTextStyle}"
                                                        Text="No candidate selected."
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button
                                                    x:Name="UseRuleCandidateButton"
                                                    HorizontalAlignment="Stretch"
                                                    Content="Use this rule"
                                                    IsEnabled="False"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Click="UseRuleCandidateButton_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <Border
                                    x:Name="ManualRulePanel"
                                    Style="{StaticResource CardStyle}"
                                    Visibility="Collapsed">
                                    <StackPanel Spacing="14">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="ManualRuleIdentityComboBox" Header="Identity" SelectedIndex="0">
                                                <ComboBoxItem Content="File name and optional minimum version" Tag="FileName" />
                                                <ComboBoxItem Content="File path" Tag="FilePath" />
                                                <ComboBoxItem Content="SHA-1 or SHA-256 hash" Tag="Hash" />
                                            </ComboBox>
                                            <ComboBox x:Name="ManualRuleScenarioComboBox" Grid.Column="1" Header="Target" SelectedIndex="0">
                                                <ComboBoxItem Content="Applications" Tag="Applications" />
                                                <ComboBoxItem Content="Drivers" Tag="Drivers" />
                                                <ComboBoxItem Content="Applications and drivers" Tag="ApplicationsAndDrivers" />
                                            </ComboBox>
                                            <TextBox
                                                x:Name="ManualRuleVersionTextBox"
                                                Grid.Column="2"
                                                Header="Minimum version (optional)"
                                                PlaceholderText="1.0.0.0" />
                                        </Grid>
                                        <TextBox
                                            x:Name="ManualRuleValueTextBox"
                                            Header="Rule value"
                                            PlaceholderText="Example.exe, C:\Program Files\Example\Example.exe, or a hexadecimal hash" />
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                            <Button Content="Cancel" Click="CancelManualRuleButton_Click" />
                                            <Button
                                                Content="Analyze manual rule"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Click="AnalyzeManualRuleButton_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="SettingsPage" Visibility="Collapsed">
                            <StackPanel Spacing="20">
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Choose the output file" />
                                    <TextBlock
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="The selected policy source will be saved and compiled in your Documents folder." />
                                </StackPanel>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="20">
                                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Policy file" />

                                        <TextBox
                                            x:Name="PolicyNameTextBox"
                                            Header="File name"
                                            PlaceholderText="SignedAndReputable_2026-09-14"
                                            TextChanged="PolicyNameTextBox_TextChanged" />

                                        <TextBox
                                            x:Name="OutputPathTextBox"
                                            Header="Save policy to"
                                            IsReadOnly="True" />

                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="18"
                                                Glyph="&#xE8B7;" />
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock
                                                    x:Name="OutputTemplateName"
                                                    FontWeight="SemiBold"
                                                    Text="Signed and reputable template" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="Multiple-policy XML; unselected and unknown policy content is preserved." />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <InfoBar
                                    x:Name="IdentityInfoBar"
                                    IsOpen="True"
                                    IsClosable="False"
                                    Severity="Informational"
                                    Title="New policy identity"
                                    Message="The wizard assigns a unique policy ID, friendly name, and version 1.0.0.0 before compiling the .cip file." />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="ReviewPage" Visibility="Collapsed">
                            <StackPanel Spacing="20">
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Review and create" />
                                    <TextBlock
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="Confirm the selected policy source and destination before creating the working policy files." />
                                </StackPanel>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="20">
                                        <Grid ColumnSpacing="20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="5">
                                                <TextBlock
                                                    x:Name="ReviewPolicyName"
                                                    Style="{StaticResource SectionTitleStyle}"
                                                    Text="SignedAndReputable_2026-09-14.xml" />
                                                <TextBlock
                                                    x:Name="ReviewTemplate"
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="Signed and reputable template" />
                                            </StackPanel>
                                            <Border
                                                Grid.Column="1"
                                                Padding="10,5"
                                                VerticalAlignment="Top"
                                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                CornerRadius="12">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                    Text="Ready" />
                                            </Border>
                                        </Grid>

                                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                        <StackPanel Spacing="4">
                                            <TextBlock FontWeight="SemiBold" Text="Policy behavior" />
                                            <TextBlock
                                                x:Name="ReviewBehavior"
                                                Style="{StaticResource SecondaryTextStyle}"
                                                Text="Audit • Applications and drivers" />
                                            <TextBlock
                                                x:Name="ReviewChanges"
                                                Style="{StaticResource SecondaryTextStyle}"
                                                Text="No administrator option changes." />
                                        </StackPanel>

                                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                        <StackPanel Spacing="4">
                                            <TextBlock FontWeight="SemiBold" Text="Application rules" />
                                            <TextBlock
                                                x:Name="ReviewRules"
                                                Style="{StaticResource SecondaryTextStyle}"
                                                Text="No application rule changes." />
                                        </StackPanel>

                                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                        <Grid ColumnSpacing="24" RowSpacing="18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Spacing="4">
                                                <TextBlock FontWeight="SemiBold" Text="Policy changes" />
                                                <TextBlock
                                                    x:Name="ReviewMode"
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="Unique identity; rules unchanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock FontWeight="SemiBold" Text="Policy format" />
                                                <TextBlock
                                                    x:Name="ReviewFormat"
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="Multiple-policy XML" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Spacing="4">
                                                <TextBlock FontWeight="SemiBold" Text="Output type" />
                                                <TextBlock
                                                    x:Name="ReviewUserMode"
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="XML and compiled .cip" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                                <TextBlock FontWeight="SemiBold" Text="Output" />
                                                <TextBlock
                                                    x:Name="ReviewOutput"
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="Documents\AppControl\Windows workstation baseline.xml"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <InfoBar
                                    x:Name="ReviewInfoBar"
                                    IsOpen="True"
                                    IsClosable="False"
                                    Severity="Informational"
                                    Title="Ready to create"
                                    Message="ConfigCI will assign a unique identity and compile the policy. The template's rules and options remain unchanged." />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <Border
                    Grid.Row="2"
                    Padding="24,12"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Width="200" VerticalAlignment="Center" Spacing="5">
                            <TextBlock
                                x:Name="ProgressText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Step 1 of 5" />
                            <ProgressBar
                                x:Name="WorkflowProgress"
                                Maximum="5"
                                Minimum="0"
                                Value="1" />
                        </StackPanel>

                        <Button
                            x:Name="BackButton"
                            Grid.Column="1"
                            MinWidth="96"
                            Content="Back"
                            IsEnabled="False"
                            Click="BackButton_Click" />

                        <Button
                            x:Name="NextButton"
                            Grid.Column="2"
                            MinWidth="120"
                            Content="Next"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="NextButton_Click" />
                    </Grid>
                </Border>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
