<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AppControl.PolicyWizard.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="App Control Policy Wizard"
            Subtitle="Policy workflow">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            CompactModeThresholdWidth="800"
            CompactPaneLength="48"
            ExpandedModeThresholdWidth="1050"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            IsPaneToggleButtonVisible="True"
            OpenPaneLength="216"
            PaneDisplayMode="Auto"
            SelectionFollowsFocus="Disabled">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Icon="Home" Tag="home" />
                <NavigationViewItem
                    x:Name="CreatePolicyNavigationItem"
                    Content="Create or edit policy"
                    Icon="Edit"
                    IsSelected="True"
                    Tag="policy" />
                <NavigationViewItem Content="Merge policies" Icon="Copy" IsEnabled="False" Tag="merge" />

                <NavigationViewItemSeparator />

                <NavigationViewItemHeader Content="Policy workflow" />
                <NavigationViewItem
                    x:Name="TemplateStepNavigationItem"
                    Content="1  Choose source"
                    SelectsOnInvoked="False" />
                <NavigationViewItem
                    x:Name="SettingsStepNavigationItem"
                    Content="2  Choose output"
                    IsEnabled="False"
                    SelectsOnInvoked="False" />
                <NavigationViewItem
                    x:Name="ReviewStepNavigationItem"
                    Content="3  Review"
                    IsEnabled="False"
                    SelectsOnInvoked="False" />
            </NavigationView.MenuItems>

            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <InfoBar
                    x:Name="ValidationInfoBar"
                    Margin="32,16,32,0"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Warning"
                    Title="Check the policy settings" />

                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <Grid
                        MaxWidth="980"
                        Padding="32,24,32,36"
                        HorizontalAlignment="Stretch">

                        <Grid x:Name="TemplatePage">
                            <StackPanel Spacing="20">
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Choose a policy source" />
                                    <TextBlock
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="Start from a recommended Microsoft template or continue from an existing App Control policy." />
                                </StackPanel>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        x:Name="SignedReputableButton"
                                        Grid.Column="0"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        AutomationProperties.Name="Select Signed and reputable template"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Tag="Signed and Reputable"
                                        Click="PolicySourceCard_Click">
                                        <Border
                                            x:Name="SignedReputableCard"
                                            Style="{StaticResource CardStyle}">
                                            <StackPanel Spacing="12">
                                                <Grid>
                                                    <Border
                                                        Width="44"
                                                        Height="44"
                                                        HorizontalAlignment="Left"
                                                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                        CornerRadius="8">
                                                        <FontIcon
                                                            FontFamily="Segoe Fluent Icons"
                                                            FontSize="22"
                                                            Glyph="&#xEA18;" />
                                                    </Border>
                                                    <Border
                                                        Padding="8,3"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                                        CornerRadius="10">
                                                        <TextBlock
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Text="RECOMMENDED" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock
                                                    Style="{StaticResource SectionTitleStyle}"
                                                    Text="Signed and reputable" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="Extends the Windows baseline with Smart App Control reputation for broader application compatibility." />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon
                                                        x:Name="SignedReputableSelectedIcon"
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="14"
                                                        Glyph="&#xE73E;" />
                                                    <TextBlock
                                                        x:Name="SignedReputableSelectionText"
                                                        VerticalAlignment="Center"
                                                        FontWeight="SemiBold"
                                                        Text="Selected" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Button>

                                    <Button
                                        x:Name="WindowsOnlyButton"
                                        Grid.Column="1"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        AutomationProperties.Name="Select Windows only template"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Tag="Windows Only"
                                        Click="PolicySourceCard_Click">
                                        <Border
                                            x:Name="WindowsOnlyCard"
                                            Style="{StaticResource CardStyle}">
                                            <StackPanel Spacing="12">
                                                <Border
                                                    Width="44"
                                                    Height="44"
                                                    HorizontalAlignment="Left"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                    CornerRadius="8">
                                                    <FontIcon
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="22"
                                                        Glyph="&#xE7F8;" />
                                                </Border>
                                                <TextBlock
                                                    Style="{StaticResource SectionTitleStyle}"
                                                    Text="Windows only" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="Uses the Windows-only baseline for tightly managed devices with the narrowest application compatibility." />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon
                                                        x:Name="WindowsOnlySelectedIcon"
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="14"
                                                        Glyph="&#xE73E;"
                                                        Visibility="Collapsed" />
                                                    <TextBlock
                                                        x:Name="WindowsOnlySelectionText"
                                                        VerticalAlignment="Center"
                                                        FontWeight="SemiBold"
                                                        Text="Selected"
                                                        Visibility="Collapsed" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Button>

                                    <Button
                                        x:Name="ExistingPolicyButton"
                                        Grid.Column="2"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        AutomationProperties.Name="Open an existing App Control policy"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Tag="Existing Policy"
                                        Click="PolicySourceCard_Click">
                                        <Border
                                            x:Name="ExistingPolicyCard"
                                            Style="{StaticResource CardStyle}">
                                            <StackPanel Spacing="12">
                                                <Border
                                                    Width="44"
                                                    Height="44"
                                                    HorizontalAlignment="Left"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                    CornerRadius="8">
                                                    <FontIcon
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="22"
                                                        Glyph="&#xE8E5;" />
                                                </Border>
                                                <TextBlock
                                                    Style="{StaticResource SectionTitleStyle}"
                                                    Text="Open existing policy" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="Continue from an App Control XML policy saved elsewhere on this device." />
                                                <TextBlock
                                                    x:Name="ExistingPolicyFileName"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    TextTrimming="CharacterEllipsis"
                                                    Visibility="Collapsed" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon
                                                        x:Name="ExistingPolicySelectedIcon"
                                                        FontFamily="Segoe Fluent Icons"
                                                        FontSize="14"
                                                        Glyph="&#xE73E;"
                                                        Visibility="Collapsed" />
                                                    <TextBlock
                                                        x:Name="ExistingPolicySelectionText"
                                                        VerticalAlignment="Center"
                                                        FontWeight="SemiBold"
                                                        Text="Selected"
                                                        Visibility="Collapsed" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </Grid>

                                <InfoBar
                                    IsOpen="True"
                                    IsClosable="False"
                                    Severity="Informational"
                                    Title="One policy workflow"
                                    Message="Templates create a new policy identity. Existing policies preserve their identity. Event-derived rules are not included yet." />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="SettingsPage" Visibility="Collapsed">
                            <StackPanel Spacing="20">
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Choose the output file" />
                                    <TextBlock
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="The selected policy source will be saved and compiled in your Documents folder." />
                                </StackPanel>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="20">
                                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Policy file" />

                                        <TextBox
                                            x:Name="PolicyNameTextBox"
                                            Header="File name"
                                            PlaceholderText="SignedAndReputable_2026-09-14"
                                            TextChanged="PolicyNameTextBox_TextChanged" />

                                        <TextBox
                                            x:Name="OutputPathTextBox"
                                            Header="Save policy to"
                                            IsReadOnly="True" />

                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="18"
                                                Glyph="&#xE8B7;" />
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock
                                                    x:Name="OutputTemplateName"
                                                    FontWeight="SemiBold"
                                                    Text="Signed and reputable template" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="Multiple-policy XML; rules and policy options remain unchanged." />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <InfoBar
                                    x:Name="IdentityInfoBar"
                                    IsOpen="True"
                                    IsClosable="False"
                                    Severity="Informational"
                                    Title="New policy identity"
                                    Message="The wizard assigns a unique policy ID, friendly name, and version 1.0.0.0 before compiling the .cip file." />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="ReviewPage" Visibility="Collapsed">
                            <StackPanel Spacing="20">
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Review and create" />
                                    <TextBlock
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="Confirm the selected policy source and destination before creating the working policy files." />
                                </StackPanel>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="20">
                                        <Grid ColumnSpacing="20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="5">
                                                <TextBlock
                                                    x:Name="ReviewPolicyName"
                                                    Style="{StaticResource SectionTitleStyle}"
                                                    Text="SignedAndReputable_2026-09-14.xml" />
                                                <TextBlock
                                                    x:Name="ReviewTemplate"
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="Signed and reputable template" />
                                            </StackPanel>
                                            <Border
                                                Grid.Column="1"
                                                Padding="10,5"
                                                VerticalAlignment="Top"
                                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                CornerRadius="12">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                    Text="Ready" />
                                            </Border>
                                        </Grid>

                                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                        <Grid ColumnSpacing="24" RowSpacing="18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Spacing="4">
                                                <TextBlock FontWeight="SemiBold" Text="Policy changes" />
                                                <TextBlock
                                                    x:Name="ReviewMode"
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="Unique identity; rules unchanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock FontWeight="SemiBold" Text="Policy format" />
                                                <TextBlock
                                                    x:Name="ReviewFormat"
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="Multiple-policy XML" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Spacing="4">
                                                <TextBlock FontWeight="SemiBold" Text="Output type" />
                                                <TextBlock
                                                    x:Name="ReviewUserMode"
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="XML and compiled .cip" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                                <TextBlock FontWeight="SemiBold" Text="Output" />
                                                <TextBlock
                                                    x:Name="ReviewOutput"
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="Documents\AppControl\Windows workstation baseline.xml"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <InfoBar
                                    x:Name="ReviewInfoBar"
                                    IsOpen="True"
                                    IsClosable="False"
                                    Severity="Informational"
                                    Title="Ready to create"
                                    Message="ConfigCI will assign a unique identity and compile the policy. The template's rules and options remain unchanged." />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <Border
                    Grid.Row="2"
                    Padding="24,12"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Width="200" VerticalAlignment="Center" Spacing="5">
                            <TextBlock
                                x:Name="ProgressText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Step 1 of 3" />
                            <ProgressBar
                                x:Name="WorkflowProgress"
                                Maximum="3"
                                Minimum="0"
                                Value="1" />
                        </StackPanel>

                        <Button
                            x:Name="BackButton"
                            Grid.Column="1"
                            MinWidth="96"
                            Content="Back"
                            IsEnabled="False"
                            Click="BackButton_Click" />

                        <Button
                            x:Name="NextButton"
                            Grid.Column="2"
                            MinWidth="120"
                            Content="Next"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="NextButton_Click" />
                    </Grid>
                </Border>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
